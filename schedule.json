{
  "watchdog": {
    "idleTimeoutSeconds": 300,
    "restartDelaySeconds": 5,
    "activeHours": {
      "start": "00:00",
      "end": "23:59",
      "timezone": "America/New_York"
    }
  },
  "briefs": [
    { "name": "morning", "time": "08:00", "type": "morning", "enabled": true },
    { "name": "midday", "time": "12:00", "type": "midday", "enabled": true },
    { "name": "evening", "time": "17:00", "type": "evening", "enabled": true }
  ],
  "agent": {
    "name": "Edith",
    "bootDate": "2026-03-18",
    "maxTurns": 100,
    "costLimits": {
      "perDay": 10,
      "perMonth": 200
    }
  },
  "needs": {
    "journalArchiveAfterDays": 7,
    "memoryCharLimit": 8000,
    "memoryWarningThreshold": 0.8,
    "memoryCriticalThreshold": 0.95
  },
  "daemon": {
    "logDir": "./logs",
    "journalDir": "./journal"
  },
  "summarizer": {
    "watchDirs": [
      { "path": "./mind/knowledge", "label": "Knowledge" },
      { "path": "/Users/randywilson/Documents/Obsidian Vault", "label": "Obsidian" }
    ],
    "outputPath": "./mind/.summaries.json",
    "maxTotalTokens": 2000
  }
}